# Entorno de PRODUCCIÓN.
# Copiar a .env.prod y cambiar POSTGRES_PASSWORD antes de desplegar:
#   cp .env.prod.example .env.prod
#
# En producción no se publica ningún puerto de PostgreSQL ni del backend.
# El frontend se publica a través de Nginx Proxy Manager (red externa red_proxy).

POSTGRES_DB=fixges
POSTGRES_USER=fixges
POSTGRES_PASSWORD=CAMBIAR_ESTA_CLAVE
