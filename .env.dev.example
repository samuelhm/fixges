# Entorno de DESARROLLO local.
# `make dev` copia este archivo a .env.dev si no existe.
# No usar estas credenciales en producción.

POSTGRES_DB=fixges
POSTGRES_USER=fixges
POSTGRES_PASSWORD=fixges_dev_password

# Puerto del host para conectarse a PostgreSQL (solo en desarrollo).
POSTGRES_PORT=5432

# Puerto del host para el frontend (nginx).
FRONTEND_PORT=80
